# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit, never ship to the browser.
SUPABASE_SECRET_KEY=<server-only-secret-key>

# ---- App / WebAuthn (must match the registered domain exactly) ----
NEXT_PUBLIC_APP_URL=https://attendance.example.edu
WEBAUTHN_RP_ID=attendance.example.edu
WEBAUTHN_ORIGIN=https://attendance.example.edu
WEBAUTHN_RP_NAME=University Attendance

# ---- Secrets (SERVER ONLY) ----
# 32 random bytes, base64 or 64 hex chars:   openssl rand -base64 32
QR_MASTER_KEY=<32-byte-random-key-for-secret-encryption>
# Use a separate 32-byte key for browser-installation hashes on a NEW deployment.
# Set it before the first student device is registered and keep it stable.
# If omitted, the app falls back to QR_MASTER_KEY for backwards compatibility.
INSTALLATION_HASH_KEY=<separate-32-byte-random-key-for-installation-hashes>
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token):   openssl rand -hex 24
CRON_SECRET=<random-string>

# ---- Optional ----
ATTENDANCE_TIMEZONE=Africa/Cairo
# "enforce" once you have confirmed staging shows no CSP violations in the browser console
CSP_MODE=report-only
GPS_RETENTION_DAYS=30
